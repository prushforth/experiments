<mapml- xmlns="http://www.w3.org/1999/xhtml">
  <map-head>
    <map-title>Картографічний сервіс веб-тайлів Організації Об'єднаних Націй</map-title>
    <map-meta charset="utf-8"></map-meta>
    <map-meta http-equiv="Content-Type" content="text/mapml;projection=OSMTILE"></map-meta>
    <map-meta name="projection" content="OSMTILE"></map-meta>
    <map-link rel="suggestions" tref="https://photon.komoot.io/api?q={searchTerms}"></map-link>
    <map-link rel="search" tref="https://photon.komoot.io/api?q={searchTerms}"></map-link>
    <map-link rel="license" href="https://www.un.org/geospatial/mapsgeo/webservices" title="Підготовлено Геопросторовою службою Організації Об'єднаних Націй"></map-link>
  </map-head>
  <map-body>
    <map-extent units="OSMTILE" checked="checked">
      <map-input name="TileMatrix" type="zoom" value="12" min="0" max="12"></map-input>
      <map-input name="TileCol" type="location" units="tilematrix" axis="column" min="0" max="262144"></map-input>
      <map-input name="TileRow" type="location" units="tilematrix" axis="row" min="0" max="262144"></map-input>
      <map-link rel="tile" type="image/png" tref="https://geoservices.un.org/arcgis/rest/services/ClearMap_WebTopo/MapServer/tile/{TileMatrix}/{TileRow}/{TileCol}"></map-link>
    </map-extent>
  </map-body>
</mapml->
