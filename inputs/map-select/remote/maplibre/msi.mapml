<mapml- xmlns="http://www.w3.org/1999/xhtml">
  <map-head>
    <map-title>Minimum snow and ice</map-title>
    <map-meta charset="utf-8"></map-meta>
    <map-link rel="license" title="Open Government Licence" href="https://datacube.services.geo.ca/ows/msi?SERVICE=WMS&amp;REQUEST=GetCapabilities&amp;VERSION=1.3.0"></map-link>
    <map-link rel="legend" type="image/png" title="legend" sizes="150x33" href="https://datacube.services.geo.ca/assets/legend/legend_msi_color.png"></map-link>
  </map-head>
  <map-body>
    <map-extent units="OSMTILE" checked="checked">
      <map-input name="z" type="zoom" value="18" min="0" max="18"></map-input>
      <map-input name="xmin" type="location" units="pcrs" position="top-left" axis="easting" min="-19736089.485420395" max="-1110810.8645190855"></map-input>
      <map-input name="ymin" type="location" units="pcrs" position="bottom-left" axis="northing" min="4069264.1959450003" max="19312495.99057358"></map-input>
      <map-input name="xmax" type="location" units="pcrs" position="top-right" axis="easting" min="-19736089.485420395" max="-1110810.8645190855"></map-input>
      <map-input name="ymax" type="location" units="pcrs" position="top-left" axis="northing" min="4069264.1959450003" max="19312495.99057358"></map-input>
      <map-input name="w" type="width"></map-input>
      <map-input name="h" type="height"></map-input>
      <map-select name="time">
        <map-option>2000-08-15T00:00:00Z</map-option>
        <map-option>2001-08-15T00:00:00Z</map-option>
        <map-option>2002-08-15T00:00:00Z</map-option>
        <map-option>2003-08-15T00:00:00Z</map-option>
        <map-option>2004-08-15T00:00:00Z</map-option>
        <map-option>2005-08-15T00:00:00Z</map-option>
        <map-option>2006-08-15T00:00:00Z</map-option>
        <map-option>2007-08-15T00:00:00Z</map-option>
        <map-option>2008-08-15T00:00:00Z</map-option>
        <map-option>2009-08-15T00:00:00Z</map-option>
        <map-option>2010-08-15T00:00:00Z</map-option>
        <map-option>2011-08-15T00:00:00Z</map-option>
        <map-option>2012-08-15T00:00:00Z</map-option>
        <map-option>2013-08-15T00:00:00Z</map-option>
        <map-option>2014-08-15T00:00:00Z</map-option>
        <map-option>2015-08-15T00:00:00Z</map-option>
        <map-option>2016-08-15T00:00:00Z</map-option>
        <map-option>2017-08-15T00:00:00Z</map-option>
        <map-option>2018-08-15T00:00:00Z</map-option>
        <map-option>2019-08-15T00:00:00Z</map-option>
        <map-option>2020-08-15T00:00:00Z</map-option>
      </map-select>
      <map-link rel="image" tref="https://datacube.services.geo.ca/ows/msi?SERVICE=WMS&amp;REQUEST=GetMap&amp;FORMAT=image/png&amp;TRANSPARENT=TRUE&amp;STYLES=msi-color&amp;VERSION=1.3.0&amp;LAYERS=msi&amp;WIDTH={w}&amp;HEIGHT={h}&amp;CRS=EPSG:3857&amp;BBOX={xmin},{ymin},{xmax},{ymax}&amp;TIME={time}"></map-link>
    </map-extent>
  </map-body>
</mapml->
