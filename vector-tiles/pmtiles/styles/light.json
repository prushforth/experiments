{
  "version": 8,
  "name": "protomaps-light",
  "layers": [
    {
      "id": "earth",
      "type": "fill",
      "source-layer": "earth",
      "paint": { "fill-color": "#f5f2eb" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source-layer": "landcover",
      "paint": { "fill-color": "#e3ebe0", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e6e6d8", "fill-opacity": 0.7 }
    },
    {
      "id": "natural",
      "type": "fill",
      "source-layer": "natural",
      "paint": { "fill-color": "#d8e6cf", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "paint": { "fill-color": "#a0c8e8" }
    },
    {
      "id": "physical-lines",
      "type": "line",
      "source-layer": "physical_line",
      "paint": { "line-color": "#8bb0cc", "line-width": 0.6 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source-layer": "buildings",
      "paint": { "fill-color": "#e0ded9" }
    },
    {
      "id": "roads",
      "type": "line",
      "source-layer": "roads",
      "paint": { "line-color": "#cbb8a0", "line-width": 1 }
    },
    {
      "id": "transit",
      "type": "line",
      "source-layer": "transit",
      "paint": { "line-color": "#b0a0b0", "line-width": 0.7 }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9a8fa0",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "places-labels",
      "type": "symbol",
      "source-layer": "places",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}
