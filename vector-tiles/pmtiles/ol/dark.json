{
  "version": 8,
  "name": "protomaps-dark",
  "layers": [
    {
      "id": "earth",
      "type": "fill",
      "source-layer": "earth",
      "paint": { "fill-color": "#1b1b1f" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source-layer": "landcover",
      "paint": { "fill-color": "#23272a", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source-layer": "landuse",
      "paint": { "fill-color": "#242424", "fill-opacity": 0.7 }
    },
    {
      "id": "natural",
      "type": "fill",
      "source-layer": "natural",
      "paint": { "fill-color": "#1f2a22", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source-layer": "water",
      "paint": { "fill-color": "#16344a" }
    },
    {
      "id": "physical-lines",
      "type": "line",
      "source-layer": "physical_line",
      "paint": { "line-color": "#2b4b60", "line-width": 0.6 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source-layer": "buildings",
      "paint": { "fill-color": "#2a2a2e" }
    },
    {
      "id": "roads",
      "type": "line",
      "source-layer": "roads",
      "paint": { "line-color": "#555555", "line-width": 1 }
    },
    {
      "id": "transit",
      "type": "line",
      "source-layer": "transit",
      "paint": { "line-color": "#4a4a55", "line-width": 0.7 }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#8a8a95",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "places-labels",
      "type": "symbol",
      "source-layer": "places",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#dddddd",
        "text-halo-color": "#000000",
        "text-halo-width": 1.2
      }
    }
  ]
}
