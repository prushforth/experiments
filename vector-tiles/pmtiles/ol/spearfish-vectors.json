{
  "version": 8,
  "name": "spearfish-vectors",
  "layers": [
    {
      "id": "restricted-fill",
      "type": "fill",
      "source-layer": "restricted",
      "paint": { "fill-color": "#ff0000", "fill-opacity": 0.5 }
    },
    {
      "id": "restricted-line",
      "type": "line",
      "source-layer": "restricted",
      "paint": { "line-color": "#ff0000", "line-width": 2 }
    },
    {
      "id": "streams",
      "type": "line",
      "source-layer": "streams",
      "paint": { "line-color": "steelblue", "line-width": 2 }
    },
    {
      "id": "roads",
      "type": "line",
      "source-layer": "roads",
      "paint": { "line-color": "maroon", "line-width": 2 }
    },
    {
      "id": "bugsites",
      "type": "circle",
      "source-layer": "bugsites",
      "paint": { "circle-radius": 3, "circle-color": "#000000" }
    },
    {
      "id": "archsites",
      "type": "circle",
      "source-layer": "archsites",
      "paint": { "circle-radius": 3, "circle-color": "#ff0000" }
    },
    {
      "id": "archsites-labels",
      "type": "symbol",
      "source-layer": "archsites",
      "filter": ["!=", ["get", "str1"], "no name"],
      "layout": {
        "text-field": ["get", "str1"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#000000",
        "text-halo-width": 2
      }
    }
  ]
}
