<mapml- xmlns="http://www.w3.org/1999/xhtml">
  <map-head>
    <map-title>Countries (WorldCRS84Quad)</map-title>
    <map-meta charset="utf-8"></map-meta>
    <map-link rel="stylesheet" href="../styles/vector-tile.css" />
    <map-link rel="alternate" projection="OSMTILE" href="osmtile-tiles.mapml" />
  </map-head>
  <map-body>
    <map-extent units="WGS84" checked="checked" hidden="hidden">
      <map-input name="zoomLevel" type="zoom" min="0" max="2" value="0"></map-input>
      <map-input name="row" type="location" axis="row" units="tilematrix" min="0" max="5"></map-input>
      <map-input name="col" type="location" axis="column" units="tilematrix" min="0" max="5"></map-input>
      <map-link rel="tile" type="text/mapml" title="Tiles for ne_10m_admin_0_countries (as MapML)" tref="../tiles/wgs84/{zoomLevel}/r{row}_c{col}.mapml" />
    </map-extent>
  </map-body>
</mapml->
