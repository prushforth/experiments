{
	"id": "./web-map.html",
	"short_name": "GeoJSON web-map (MapLibre)",
	"name": "MapML GeoJSON Viewer, web-map — MapML-MapLibre",
	"description": "Opens .geojson files on a <map is=\"web-map\"> map rendered by MapML-MapLibre.",
	"icons": [
		{
			"src": "../images/treasure-map-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "../images/treasure-map-256.png",
			"sizes": "256x256",
			"type": "image/png"
		}
	],
	"start_url": "./web-map.html",
	"scope": "./web-map.html",
	"theme_color": "#db7093",
	"background_color": "#222222",
	"display": "standalone",
	"file_handlers": [
		{
			"action": "./web-map.html?log=y",
			"accept": {
				"application/geo+json": [".geojson"]
			},
			"icons": [
				{
					"src": "../images/treasure-map-256.png",
					"sizes": "256x256",
					"type": "image/png"
				}
			],
			"launch_type": "multiple-clients"
		}
	]
}
